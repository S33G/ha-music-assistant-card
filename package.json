{
  "name": "ha-music-assistant-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write src tests *.json *.mjs *.ts README.md",
    "format:check": "prettier --check src tests *.json *.mjs *.ts README.md",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
